;; mathlib.wat — Phase 38 extended Math library for wasic
;; Exports: sin, cos, tan, asin, acos, atan, atan2,
;;          exp, log, log2, log10, cbrt,
;;          sinh, cosh, tanh, asinh, acosh, atanh,
;;          expm1, log1p, random
;;
;; All functions operate on f64. random() uses a module-level xorshift64 PRNG.
;; This module is compiled to mathlib.wasm and auto-bundled by wasic when any
;; of these Math.* functions appear in the compiled TypeScript source.
;;
;; To regenerate mathlib.wasm:
;;   wasmtk convert src/wasm/mathlib.wat  (output goes to src/wasm/mathlib.wasm)
;; To regenerate mathlib_bytes.ts:
;;   deno run --allow-read --allow-write scripts/gen_mathlib_bytes.ts
(module
  ;; ── RNG state (xorshift64 seed) ─────────────────────────────────────────────
  (global $__rng_state (mut i64) (i64.const 0x6C62272E07BB0142))
  ;; ── trig argument-reduction output (r, rt) — see $__trig_reduce ─────────────
  (global $__tr  (mut f64) (f64.const 0.0))
  (global $__trt (mut f64) (f64.const 0.0))

  ;; ── Math.random — xorshift64, returns f64 in [0, 1) ────────────────────────
  (func $random (export "random") (result f64)
    (local $s i64)
    (local.set $s (global.get $__rng_state))
    (local.set $s (i64.xor (local.get $s) (i64.shl  (local.get $s) (i64.const 13))))
    (local.set $s (i64.xor (local.get $s) (i64.shr_u (local.get $s) (i64.const 7))))
    (local.set $s (i64.xor (local.get $s) (i64.shl  (local.get $s) (i64.const 17))))
    (global.set $__rng_state (local.get $s))
    (f64.sub
      (f64.reinterpret_i64
        (i64.or (i64.shr_u (local.get $s) (i64.const 12)) (i64.const 0x3FF0000000000000)))
      (f64.const 1.0))
  )

  ;; ── fdlibm trig: __kernel_sin/__kernel_cos + Veltkamp-split argument reduction ──
  ;; Reduction: n = rint(x * 2/pi); r + rt = x - n*(pi/2) accumulated in double-double
  ;; using the 7 fdlibm PIo2[] 24-bit chunks. n is Veltkamp-split (nhi<=24 sig bits +
  ;; nlo) so every nhi*PIo2[i] / nlo*PIo2[i] product is EXACT, and each subtraction is
  ;; Sterbenz-exact — so r is accurate to full precision. Result matches V8 to <=1 ULP
  ;; for |x| < ~1e12 (and stays ~14 sig-figs out to 1e15). Pure arithmetic: no table
  ;; lookup, no linear memory, no Payne-Hanek — safe to splice into the merged module.
  ;; ── Correctly-rounded sin/cos via double-double (dd) arithmetic ─────────────
  ;; Matches the IEEE-754 correctly-rounded result (validated bit-for-bit vs a
  ;; BigInt fixed-point oracle over |x| < 1e12). This is the canonical value every
  ;; correct libm agrees on — max accuracy + max cross-language compatibility.
  ;; All dd helpers use Veltkamp two-product (no FMA needed) and return (hi, lo)
  ;; via WASM multi-value. Argument reduction is the table-free Veltkamp n-split
  ;; producing a dd remainder r; the dd Taylor kernels then round to nearest.
  (func $__hiw (param $x f64) (result i32)
    (i32.and (i32.wrap_i64 (i64.shr_u (i64.reinterpret_f64 (local.get $x)) (i64.const 32)))
             (i32.const 0x7fffffff)))
  ;; twoSum(a,b) -> (s, err)  [exact:  a+b = s+err]
  (func $__ts (param $a f64) (param $b f64) (result f64 f64)
    (local $s f64) (local $bb f64)
    (local.set $s (f64.add (local.get $a) (local.get $b)))
    (local.set $bb (f64.sub (local.get $s) (local.get $a)))
    (local.get $s)
    (f64.add (f64.sub (local.get $a) (f64.sub (local.get $s) (local.get $bb)))
             (f64.sub (local.get $b) (local.get $bb))))
  ;; twoProd(a,b) -> (p, err)  via Veltkamp split (exact:  a*b = p+err)
  (func $__tp (param $a f64) (param $b f64) (result f64 f64)
    (local $p f64) (local $c f64) (local $ah f64) (local $al f64) (local $bh f64) (local $bl f64)
    (local.set $p (f64.mul (local.get $a) (local.get $b)))
    (local.set $c (f64.mul (f64.const 134217729.0) (local.get $a)))
    (local.set $ah (f64.sub (local.get $c) (f64.sub (local.get $c) (local.get $a))))
    (local.set $al (f64.sub (local.get $a) (local.get $ah)))
    (local.set $c (f64.mul (f64.const 134217729.0) (local.get $b)))
    (local.set $bh (f64.sub (local.get $c) (f64.sub (local.get $c) (local.get $b))))
    (local.set $bl (f64.sub (local.get $b) (local.get $bh)))
    (local.get $p)
    (f64.add (f64.add (f64.add
      (f64.sub (f64.mul (local.get $ah) (local.get $bh)) (local.get $p))
      (f64.mul (local.get $ah) (local.get $bl)))
      (f64.mul (local.get $al) (local.get $bh)))
      (f64.mul (local.get $al) (local.get $bl))))
  ;; ddAdd((ah,al),(bh,bl)) -> (hi,lo)
  (func $__dda (param $ah f64) (param $al f64) (param $bh f64) (param $bl f64) (result f64 f64)
    (local $s f64) (local $e f64)
    (call $__ts (local.get $ah) (local.get $bh)) (local.set $e) (local.set $s)
    (local.set $e (f64.add (local.get $e) (f64.add (local.get $al) (local.get $bl))))
    (call $__ts (local.get $s) (local.get $e)))
  ;; ddMul((ah,al),(bh,bl)) -> (hi,lo)
  (func $__ddm (param $ah f64) (param $al f64) (param $bh f64) (param $bl f64) (result f64 f64)
    (local $p f64) (local $e f64)
    (call $__tp (local.get $ah) (local.get $bh)) (local.set $e) (local.set $p)
    (local.set $e (f64.add (local.get $e)
      (f64.add (f64.mul (local.get $ah) (local.get $bl)) (f64.mul (local.get $al) (local.get $bh)))))
    (call $__ts (local.get $p) (local.get $e)))
  ;; ddRecipInt(d) -> (hi,lo)  ~ 1/d in dd
  (func $__ddri (param $d f64) (result f64 f64)
    (local $h f64) (local $p f64) (local $e f64) (local $res f64)
    (local.set $h (f64.div (f64.const 1.0) (local.get $d)))
    (call $__tp (local.get $h) (local.get $d)) (local.set $e) (local.set $p)
    (local.set $res (f64.sub (f64.sub (f64.const 1.0) (local.get $p)) (local.get $e)))
    (call $__ts (local.get $h) (f64.mul (local.get $res) (local.get $h))))
  ;; ddMulD((ah,al), b) -> (hi,lo)
  (func $__ddmd (param $ah f64) (param $al f64) (param $b f64) (result f64 f64)
    (local $p f64) (local $e f64)
    (call $__tp (local.get $ah) (local.get $b)) (local.set $e) (local.set $p)
    (local.set $e (f64.add (local.get $e) (f64.mul (local.get $al) (local.get $b))))
    (call $__ts (local.get $p) (local.get $e)))
  ;; ddDiv((ah,al),(bh,bl)) -> (hi,lo)   3-step dd quotient
  (func $__dddiv (param $ah f64) (param $al f64) (param $bh f64) (param $bl f64) (result f64 f64)
    (local $q1 f64) (local $q2 f64) (local $q3 f64)
    (local $ph f64) (local $pl f64) (local $rh f64) (local $rl f64) (local $h f64) (local $l f64)
    (local.set $q1 (f64.div (local.get $ah) (local.get $bh)))
    (call $__ddmd (local.get $bh) (local.get $bl) (local.get $q1)) (local.set $pl) (local.set $ph)
    (call $__dda (local.get $ah) (local.get $al) (f64.neg (local.get $ph)) (f64.neg (local.get $pl))) (local.set $rl) (local.set $rh)
    (local.set $q2 (f64.div (local.get $rh) (local.get $bh)))
    (call $__ddmd (local.get $bh) (local.get $bl) (local.get $q2)) (local.set $pl) (local.set $ph)
    (call $__dda (local.get $rh) (local.get $rl) (f64.neg (local.get $ph)) (f64.neg (local.get $pl))) (local.set $rl) (local.set $rh)
    (local.set $q3 (f64.div (local.get $rh) (local.get $bh)))
    (call $__ts (local.get $q1) (local.get $q2)) (local.set $l) (local.set $h)
    (local.set $l (f64.add (local.get $l) (local.get $q3)))
    (call $__ts (local.get $h) (local.get $l)))
  ;; ddsin(r) -> (hi,lo)   dd Taylor, |r| <= pi/4
  (func $__ddsin (param $rh f64) (param $rl f64) (result f64 f64)
    (local $r2h f64) (local $r2l f64) (local $th f64) (local $tl f64) (local $sh f64) (local $sl f64)
    (local $ch f64) (local $cl f64) (local $k i32) (local $d f64)
    (call $__ddm (local.get $rh) (local.get $rl) (local.get $rh) (local.get $rl)) (local.set $r2l) (local.set $r2h)
    (local.set $th (local.get $rh)) (local.set $tl (local.get $rl))
    (local.set $sh (local.get $rh)) (local.set $sl (local.get $rl))
    (local.set $k (i32.const 1))
