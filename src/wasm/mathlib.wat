      (local.set $d (f64.convert_i32_s (i32.mul (i32.const -1)
        (i32.mul (i32.mul (i32.const 2) (local.get $k)) (i32.add (i32.mul (i32.const 2) (local.get $k)) (i32.const 1))))))
      (call $__ddri (local.get $d)) (local.set $cl) (local.set $ch)
      (call $__ddm (local.get $th) (local.get $tl) (local.get $ch) (local.get $cl)) (local.set $tl) (local.set $th)
      (call $__dda (local.get $sh) (local.get $sl) (local.get $th) (local.get $tl)) (local.set $sl) (local.set $sh)
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
